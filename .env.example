# Server configuration. `just env` copies this file to `.env` and generates SECRET_KEY.
# Off localhost the server refuses development shortcuts: APP_URL must be https and
# COOKIE_SECURE true, MAIL_TRANSPORT and TEXT_TRANSPORT cannot be `log`, and SMTP
# credentials need TLS.

# Docker Compose only; the server does not read these
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5433
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
APP_PORT=8080
# IMAGE_NAME=svelte-rust-template

# HTTP
BIND_ADDRESS=127.0.0.1:3000
# Where browsers open the app; links in mail point here and other origins are refused.
APP_URL=http://localhost:5173
# Directory of the built SPA to serve for non-API paths.
# STATIC_DIR=../web/build
# Defaults to true, which also works on http://localhost.
# COOKIE_SECURE=true
# Set behind a reverse proxy that sets X-Forwarded-For; TRUSTED_PROXY_HOPS counts the
# proxies in a chain.
TRUST_PROXY=false
# TRUSTED_PROXY_HOPS=1
# Defaults to 365d when APP_URL is https; 0 turns it off.
# HSTS_MAX_AGE=365d
CORS_ALLOWED_ORIGINS=
REQUEST_TIMEOUT=30s
MAX_BODY_BYTES=65536
SHUTDOWN_TIMEOUT=20s

# Rate limits
RATE_LIMITS_ENABLED=true
# `memory` is per process; `postgres` is shared by all instances.
RATE_LIMIT_STORE=memory
# RATE_LIMIT_MEMORY_MAX_KEYS=1000000
# Override a limit as `<requests>/<period>`; `off` disables it.
# RATE_LIMIT_API_PER_IP=300/1m
# RATE_LIMIT_LOGIN_PER_IP=20/1m
# RATE_LIMIT_LOGIN_PER_ACCOUNT=10/1h
# RATE_LIMIT_LOGIN_PER_ACCOUNT_TOTAL=100/1h
# RATE_LIMIT_REGISTER_PER_IP=10/1h
# RATE_LIMIT_PASSWORD_RESET_PER_IP=10/1h
# RATE_LIMIT_PASSWORD_RESET_PER_ACCOUNT=3/1h
# RATE_LIMIT_VERIFICATION_PER_IP=20/1h
# RATE_LIMIT_VERIFICATION_PER_ACCOUNT=3/1h
# RATE_LIMIT_SEND_CODE_PER_IP=20/1h
# RATE_LIMIT_SEND_CODE_PER_ACCOUNT=5/1h
# RATE_LIMIT_CHECK_CODE_PER_IP=30/1m
# RATE_LIMIT_CHECK_CODE_PER_ACCOUNT=10/1h
# RATE_LIMIT_CEREMONY_PER_IP=60/1m
# RATE_LIMIT_REPORT_PER_IP=30/1m

# Database
DATABASE_URL=postgres://app:app@localhost:5433/app
DATABASE_MAX_CONNECTIONS=10
DATABASE_ACQUIRE_TIMEOUT=5s
# Cancels long statements and idle transactions; 0 turns it off.
DATABASE_STATEMENT_TIMEOUT=30s
DATABASE_RUN_MIGRATIONS=true
# Build against the committed server/.sqlx metadata instead of DATABASE_URL.
# SQLX_OFFLINE=true

# Mail
# `smtp`, or `log` (localhost only: mail and its links go to the server log).
MAIL_TRANSPORT=smtp
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Acme <noreply@example.com>"

# Accounts
APP_NAME=Acme
# 32 random bytes, base64 (`openssl rand -base64 32`). Seals authenticator secrets and
# keys the code digests.
SECRET_KEY=
# During rotation, set the new key above and the old one here.
# SECRET_KEY_PREVIOUS=

SESSION_IDLE_TIMEOUT=7d
SESSION_LIFETIME=30d
EMAIL_VERIFICATION_TTL=24h
PASSWORD_RESET_TTL=30m
MAGIC_LINK_TTL=15m
# With `true`, new accounts cannot sign in before verifying their address, and
# registration does not reveal which addresses are taken.
REQUIRE_EMAIL_VERIFICATION=false
# Unverified accounts older than this are deleted. Defaults to 7d when verification is
# required, otherwise 0 (keep).
# UNVERIFIED_ACCOUNT_TTL=7d
# Security events (sign-ins, changed sign-in methods, role changes) are kept this long;
# 0 keeps them as long as the account.
# AUDIT_LOG_RETENTION=90d

ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1
ARGON2_MAX_CONCURRENT=4
# Sign-ins allowed to wait for a hashing slot; more get a 503.
ARGON2_MAX_QUEUED=64

# Text messages
# `none`, `log` (localhost only) or `twilio`.
TEXT_TRANSPORT=log
# Calling codes that may be texted, e.g. `+49,+43,+41`, or `*`. Required with `twilio`
# unless APP_URL is localhost.
# TEXT_ALLOWED_COUNTRIES=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=+15550001111
# TWILIO_WHATSAPP_FROM=+15550002222

# Social sign-in: a provider is on when its CLIENT_ID is set. Register
# $APP_URL/api/v1/auth/oauth/<provider>/callback with it.
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_MICROSOFT_CLIENT_ID=
# OAUTH_MICROSOFT_CLIENT_SECRET=
# `common`, `consumers`, `organizations` or a tenant id.
# OAUTH_MICROSOFT_TENANT=common
# Apple needs an https APP_URL; the private key is a PEM with `\n` for line breaks.
# OAUTH_APPLE_CLIENT_ID=com.example.web
# OAUTH_APPLE_TEAM_ID=
# OAUTH_APPLE_KEY_ID=
# OAUTH_APPLE_PRIVATE_KEY=

# Logging
# `text` or `json`.
LOG_FORMAT=text
# RUST_LOG=info,api=debug,application=debug,mail=debug,text=debug,tower_http=info,sqlx=warn
