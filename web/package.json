{
	"name": "web",
	"version": "0.0.1",
	"devDependencies": {
		"@bufbuild/buf": "^1.75.0",
		"@bufbuild/protobuf": "^2.17.0",
		"@bufbuild/protoc-gen-es": "^2.17.0",
		"@eslint/js": "^10.0.1",
		"@fluent/bundle": "^0.19.1",
		"@fluent/langneg": "^0.7.0",
		"@fluent/syntax": "^0.19.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.78.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@tailwindcss/vite": "^4.3.5",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.13",
		"@types/node": "^24",
		"@vitest/coverage-v8": "^5.1.1",
		"bits-ui": "^2.22.0",
		"cn": "0.5.2",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"jsdom": "^30.1.1",
		"mode-watcher": "^1.1.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.8.1",
		"simple-icons": "^16.38.1",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"svelte-sonner": "^1.2.3",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.74.0",
		"uqr": "^0.1.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && bun scripts/compress.js",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"gen:proto": "buf generate",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "prettier --check . && eslint . && buf lint ../proto",
		"format": "prettier --write ."
	},
	"type": "module"
}
