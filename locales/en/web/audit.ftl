## Security events, as the audit log and the security page show them. The server names
## each by a stable action; these are the words for it.

audit-action-registered = Account created
audit-action-signed-in = Signed in
audit-action-sign-in-failed = Failed sign-in attempt
audit-action-signed-out-everywhere = Signed out everywhere
audit-action-session-revoked = Signed out a device
audit-action-reauthenticated = Confirmed it was you
audit-action-email-verified = Email address verified
audit-action-email-changed = Email address changed
audit-action-email-change-cancelled = Email change cancelled
audit-action-password-reset = Password reset
audit-action-username-changed = Username changed
audit-action-phone-added = Phone number added
audit-action-phone-removed = Phone number removed
audit-action-totp-added = Authenticator app added
audit-action-totp-removed = Authenticator app removed
audit-action-recovery-codes-regenerated = New recovery codes created
audit-action-passkey-added = Passkey added
audit-action-passkey-removed = Passkey removed
audit-action-identity-linked = Social account linked
audit-action-identity-unlinked = Social account unlinked
audit-action-role-granted = Role granted
audit-action-role-revoked = Role revoked
audit-action-account-disabled = Account disabled
audit-action-account-enabled = Account enabled

# How a sign-in or confirmation was proven, shown next to the event. A social account is
# shown by its provider's name instead.
audit-method-password = Password
audit-method-registration = New account
audit-method-magic-link = Emailed link
audit-method-email-code = Emailed code
audit-method-phone-code = Texted code
audit-method-passkey = Passkey
audit-method-totp = Authenticator app
audit-method-recovery-code = Recovery code
