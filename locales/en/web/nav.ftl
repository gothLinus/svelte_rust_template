## Navigation: the sidebar, the phone tab bar, the account menu.

# Group headings of the sidebar.
nav-workspace = Workspace
nav-account = Account
nav-administration = Administration

# Names of the pages in the sidebar, the tab bar and the account menu.
nav-dashboard = Dashboard
nav-profile = Profile
nav-security = Security
nav-users = Users
nav-audit = Audit log

# Landmark name of the main navigation (screen readers).
nav-main = Main

# Last tab of the phone tab bar; opens a menu with the remaining pages.
nav-more = More

# Screen-reader text next to the logo, which links to the dashboard.
nav-logo-link = dashboard

# Screen-reader name of the button that opens the account menu on phones.
nav-account-menu = Account menu

# Account menu entry that ends the session.
nav-sign-out = Sign out

# Sidebar toggle buttons (screen readers and tooltip).
nav-toggle-sidebar = Toggle sidebar

# Title and description of the sidebar when it opens as a sheet on phones (screen readers).
nav-sidebar = Sidebar
nav-sidebar-description = Displays the mobile sidebar.

# Landmark name of a breadcrumb trail, and the screen-reader text of its collapsed "..." part.
nav-breadcrumb = Breadcrumb
nav-breadcrumb-more = More

## Pagination

# Landmark name of the previous/next buttons under a list.
pagination-label = Pagination
pagination-previous = Previous
pagination-next = Next

## Theme

# Menu entries for the color scheme.
theme-light = Light
theme-dark = Dark
theme-system = System

# Group name of the theme menu, and the name of the button that opens it.
# { $mode } is the current choice: Light, Dark or System.
theme-label = Theme
theme-button = Theme: { $mode }

## Language

# Name of the language menu. Each language is listed by its own name (English, Deutsch).
language-label = Language

