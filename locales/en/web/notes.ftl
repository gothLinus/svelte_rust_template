## Notes, the example resource. `just new-resource` copies this file and renames the ids.

# The page's name in the sidebar, the tab bar and the account menu.
notes-nav = Notes

notes-title = Notes
notes-description = Your notes, newest first.
notes-new = New note

# Screen-reader name of the group of buttons that switches between one's own and all notes.
notes-scope-label = Whose notes
notes-scope-mine = My notes
notes-scope-all = Everyone's notes

notes-empty-title = No notes yet
notes-empty-description = Notes are the example resource of this template. Create one to see the list, the dialogs and the pagination at work.
notes-create-first = Create a note

# On a note's card. $when is a relative time such as "5 minutes ago".
notes-updated = Updated { $when }
# Badge on a note somebody else wrote (shown to those who may see everyone's notes).
notes-others = Another user's

notes-edit = Edit
notes-duplicate = Duplicate
notes-delete = Delete
# Screen-reader names of the buttons on a note's card. $title is the note's title.
notes-edit-label = Edit { $title }
notes-duplicate-label = Duplicate { $title }
notes-delete-label = Delete { $title }

# Screen-reader name of the previous/next navigation below the list.
notes-pages-label = Notes pages

notes-delete-title = Delete this note?
notes-delete-description = “{ $title }” will be gone for good.
notes-delete-confirm = Delete

# Notices. $title is the note's title.
notes-created = Created “{ $title }”.
notes-saved = Note saved.
notes-deleted = Deleted “{ $title }”.

