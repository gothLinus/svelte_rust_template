## Sicherheitsereignisse, wie das Audit-Log und die Sicherheitsseite sie zeigen. Der Server benennt
## jedes mit einer stabilen Aktion; dies sind die Worte dafür.

audit-action-registered = Konto erstellt
audit-action-signed-in = Angemeldet
audit-action-sign-in-failed = Fehlgeschlagener Anmeldeversuch
audit-action-signed-out-everywhere = Überall abgemeldet
audit-action-session-revoked = Ein Gerät abgemeldet
audit-action-reauthenticated = Identität bestätigt
audit-action-email-verified = E-Mail-Adresse bestätigt
audit-action-email-changed = E-Mail-Adresse geändert
audit-action-email-change-cancelled = Änderung der E-Mail-Adresse abgebrochen
audit-action-password-reset = Passwort zurückgesetzt
audit-action-username-changed = Benutzername geändert
audit-action-phone-added = Telefonnummer hinzugefügt
audit-action-phone-removed = Telefonnummer entfernt
audit-action-totp-added = Authenticator-App hinzugefügt
audit-action-totp-removed = Authenticator-App entfernt
audit-action-recovery-codes-regenerated = Neue Wiederherstellungscodes erstellt
audit-action-passkey-added = Passkey hinzugefügt
audit-action-passkey-removed = Passkey entfernt
audit-action-identity-linked = Externes Konto verknüpft
audit-action-identity-unlinked = Verknüpfung mit externem Konto aufgehoben
audit-action-role-granted = Rolle zugewiesen
audit-action-role-revoked = Rolle entzogen
audit-action-account-disabled = Konto deaktiviert
audit-action-account-enabled = Konto aktiviert

# Wie eine Anmeldung oder Bestätigung nachgewiesen wurde, neben dem Ereignis angezeigt. Ein externes
# Konto wird stattdessen mit dem Namen seines Anbieters angezeigt.
audit-method-password = Passwort
audit-method-registration = Neues Konto
audit-method-magic-link = Link per E-Mail
audit-method-email-code = Code per E-Mail
audit-method-phone-code = Code per SMS
audit-method-passkey = Passkey
audit-method-totp = Authenticator-App
audit-method-recovery-code = Wiederherstellungscode
