## Wörter, die in der ganzen App verwendet werden.

# Schaltfläche, die einen Dialog schließt, ohne etwas zu tun.
common-cancel = Abbrechen

# Screenreader-Name einer Schließen-Schaltfläche (Dialoge und Seitenpaneele).
common-close = Schließen

# Beispiel in einem leeren E-Mail-Feld; eine Adresse, die in Ihrer Sprache als Beispiel erkennbar ist.
common-email-placeholder = name@beispiel.de

# Screenreader-Name eines Ladeindikators.
common-loading = Wird geladen
