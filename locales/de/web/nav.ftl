## Navigation: die Seitenleiste, die Tab-Leiste auf Smartphones, das Kontomenü.

# Gruppenüberschriften der Seitenleiste.
nav-workspace = Arbeitsbereich
nav-account = Konto
nav-administration = Verwaltung

# Namen der Seiten in der Seitenleiste, der Tab-Leiste und dem Kontomenü.
nav-dashboard = Übersicht
nav-profile = Profil
nav-security = Sicherheit
nav-users = Benutzer
nav-audit = Audit-Log

# Landmark-Name der Hauptnavigation (Screenreader).
nav-main = Hauptnavigation

# Letzter Tab der Tab-Leiste auf Smartphones; öffnet ein Menü mit den übrigen Seiten.
nav-more = Mehr

# Screenreader-Text neben dem Logo, das zur Übersicht verlinkt.
nav-logo-link = Übersicht

# Screenreader-Name der Schaltfläche, die auf Smartphones das Kontomenü öffnet.
nav-account-menu = Kontomenü

# Eintrag im Kontomenü, der die Sitzung beendet.
nav-sign-out = Abmelden

# Schaltflächen zum Ein- und Ausblenden der Seitenleiste (Screenreader und Tooltip).
nav-toggle-sidebar = Seitenleiste ein-/ausblenden

# Titel und Beschreibung der Seitenleiste, wenn sie sich auf Smartphones als Paneel öffnet (Screenreader).
nav-sidebar = Seitenleiste
nav-sidebar-description = Zeigt die mobile Seitenleiste an.

# Landmark-Name einer Brotkrümelnavigation und der Screenreader-Text ihres eingeklappten "..."-Teils.
nav-breadcrumb = Brotkrümelnavigation
nav-breadcrumb-more = Mehr

## Seitennavigation

# Landmark-Name der Zurück/Weiter-Schaltflächen unter einer Liste.
pagination-label = Seitennavigation
pagination-previous = Zurück
pagination-next = Weiter

## Design

# Menüeinträge für das Farbschema.
theme-light = Hell
theme-dark = Dunkel
theme-system = System

# Gruppenname des Design-Menüs und Name der Schaltfläche, die es öffnet.
# { $mode } ist die aktuelle Auswahl: Hell, Dunkel oder System.
theme-label = Design
theme-button = Design: { $mode }

## Sprache

# Name des Sprachmenüs. Jede Sprache wird mit ihrem eigenen Namen aufgeführt (English, Deutsch).
language-label = Sprache

## Website

# Der Slogan der App, als Einleitung der Startseite verwendet.
site-description = Ein Starterprojekt für SvelteKit und Rust mit integrierten Konten, Sitzungen und Berechtigungen.
