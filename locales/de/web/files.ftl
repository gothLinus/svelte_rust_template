## Dateien: Uploads im Objektspeicher, ihre Seite und der Dialog zum Umbenennen.

# Der Name der Seite in der Seitenleiste, der Tab-Leiste und im Kontomenü.
files-nav = Dateien

files-title = Dateien
files-description = Ihre Uploads, die neuesten zuerst.
files-upload = Hochladen
# Name des versteckten Dateiauswahldialogs für Screenreader, den die Schaltfläche „Hochladen“ öffnet.
files-upload-label = Dateien zum Hochladen auswählen

# Name der Schaltflächengruppe für Screenreader, die zwischen eigenen und allen Dateien umschaltet.
files-scope-label = Wessen Dateien
files-scope-mine = Meine Dateien
files-scope-all = Alle Dateien

# Über der Liste, wenn das Konto ein Kontingent hat. $used und $quota sind Größen wie „1,5 MB“.
files-usage = { $used } von { $quota } belegt
# Name des Balkens für Screenreader, der zeigt, wie voll der Speicher ist.
files-usage-label = Belegter Speicher

files-empty-title = Noch keine Dateien
files-empty-description = Laden Sie eine Datei hoch, um sie hier aufzubewahren.
files-upload-first = Datei hochladen

# Der Name, unter dem eine Datei hochgeladen wird, wenn ihr eigener nicht brauchbar ist.
files-unnamed = unbenannt

# Während eine Datei unterwegs ist. $name ist der Name der Datei.
files-uploading = „{ $name }“ wird hochgeladen …

# In der Zeile einer Datei. $size ist eine Größe wie „1,5 MB“, $type ein Medientyp wie image/png, $when eine relative Zeit wie „vor 5 Minuten“.
files-details = { $size } · { $type } · { $when }
# Kennzeichnung einer Datei, die jemand anderes hochgeladen hat (für alle sichtbar, die alle Dateien sehen dürfen).
files-others = Von einer anderen Person

files-download = Herunterladen
files-rename = Umbenennen
files-delete = Löschen
# Namen der Schaltflächen in der Zeile einer Datei für Screenreader. $name ist der Name der Datei.
files-download-label = { $name } herunterladen
files-rename-label = { $name } umbenennen
files-delete-label = { $name } löschen

# Name der Zurück-/Weiter-Navigation unter der Liste für Screenreader.
files-pages-label = Seiten der Dateien

files-delete-title = Diese Datei löschen?
files-delete-description = „{ $name }“ ist danach endgültig weg.
files-delete-confirm = Löschen

# Hinweise. $name ist der Name der Datei; $max eine Größe wie „25 MB“.
files-uploaded = „{ $name }“ hochgeladen.
files-too-large = „{ $name }“ ist größer als { $max }.
# Wenn der Server einen Upload abgelehnt hat. $reason ist sein Grund, etwa „es ist nicht mehr genug Platz für diese Datei“.
files-upload-failed = „{ $name }“ wurde nicht hochgeladen: { $reason }
files-renamed = Umbenannt in „{ $name }“.
files-deleted = „{ $name }“ gelöscht.

## Der Dialog zum Umbenennen einer Datei.

file-rename-title = Datei umbenennen
file-rename-description = Der Inhalt bleibt unverändert.
file-field-name = Name
file-rename-save = Umbenennen
# Steht unter dem Namensfeld; der Server sagt dasselbe (`file-name-invalid` in seinem Katalog).
file-name-invalid = darf keine Schrägstriche oder Steuerzeichen enthalten
