## Notizen, die Beispielressource. `just new-resource` kopiert diese Datei und benennt die Ids um.

# Der Name der Seite in der Seitenleiste, der Tab-Leiste und dem Kontomenü.
notes-nav = Notizen

notes-title = Notizen
notes-description = Ihre Notizen, die neuesten zuerst.
notes-new = Neue Notiz

# Screenreader-Name der Schaltflächengruppe, die zwischen eigenen und allen Notizen wechselt.
notes-scope-label = Wessen Notizen
notes-scope-mine = Meine Notizen
notes-scope-all = Alle Notizen

notes-empty-title = Noch keine Notizen
notes-empty-description = Notizen sind die Beispielressource dieser Vorlage. Erstellen Sie eine, um die Liste, die Dialoge und die Seitennavigation in Aktion zu sehen.
notes-create-first = Notiz erstellen

# Auf der Karte einer Notiz. $when ist eine relative Zeitangabe wie "vor 5 Minuten".
notes-updated = Aktualisiert { $when }
# Kennzeichen an einer Notiz, die jemand anderes geschrieben hat (sichtbar für alle, die alle Notizen sehen dürfen).
notes-others = Von einem anderen Benutzer

notes-edit = Bearbeiten
notes-duplicate = Duplizieren
notes-delete = Löschen
# Screenreader-Namen der Schaltflächen auf der Karte einer Notiz. $title ist der Titel der Notiz.
notes-edit-label = { $title } bearbeiten
notes-duplicate-label = { $title } duplizieren
notes-delete-label = { $title } löschen

# Screenreader-Name der Zurück/Weiter-Navigation unter der Liste.
notes-pages-label = Notizseiten

notes-delete-title = Diese Notiz löschen?
notes-delete-description = „{ $title }“ wird endgültig gelöscht.
notes-delete-confirm = Löschen

# Hinweise. $title ist der Titel der Notiz.
notes-created = „{ $title }“ erstellt.
notes-saved = Notiz gespeichert.
notes-deleted = „{ $title }“ gelöscht.

## Der Dialog zum Erstellen oder Bearbeiten einer Notiz.

note-title-new = Neue Notiz
note-title-edit = Notiz bearbeiten
note-description-new = Nur Sie können Ihre Notizen sehen.
note-description-edit = Ändern Sie den Titel oder den Text.
note-field-title = Titel
note-field-text = Text
note-save = Änderungen speichern
note-create = Notiz erstellen
note-stale = Jemand anderes hat diese Notiz zwischenzeitlich geändert. Speichern Sie erneut, um deren Änderungen durch Ihre zu ersetzen, oder brechen Sie ab, um sie zu behalten.
