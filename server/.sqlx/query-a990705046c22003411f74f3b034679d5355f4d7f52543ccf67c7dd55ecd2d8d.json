  "query": "\n                    select id, user_id, actor_id, action, detail, ip as \"ip: IpAddr\", user_agent,\n                        occurred_at\n                    from audit_events\n                    where user_id = $1 and id < $2\n                    order by id desc\n                    limit $3\n                    ",
