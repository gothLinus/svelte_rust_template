  "db_name": "PostgreSQL",
  "query": "\n            update outbox\n            set available_at = now() + make_interval(secs => $1)\n            where id in (\n                select id from outbox\n                where available_at <= now() and expires_at > now()\n                order by available_at\n                limit $2\n                for update skip locked\n            )\n            returning id, kind, payload, attempts\n            ",
